[Unit]
Description=retourenboard. - gemeinsame Retourenverwaltung
After=network.target

[Service]
Type=simple
User=retourenverwaltung
Group=retourenverwaltung
WorkingDirectory=/opt/retourenboard/current
EnvironmentFile=/etc/retourenboard.env
ExecStart=/opt/retourenboard/node/bin/node server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/retourenboard
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
Alias=retourenverwaltung.service
