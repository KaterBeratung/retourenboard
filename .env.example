# Beim ersten Browseraufruf den ersten Administrator anlegen.
PORT=3000
HOST=127.0.0.1
DATA_DIR=data
# Genau eine Verbindungsquelle setzen. Kennwort/Datei privat halten.
DATABASE_URL_FILE=data/database-url
# Alternativ DATABASE_URL=postgresql://benutzer:kennwort@127.0.0.1:5432/retourenboard
# Externe Server verwenden standardmäßig geprüftes TLS; eigene CA optional:
# DATABASE_CA_FILE=/sicherer/pfad/postgres-ca.pem
# DB_PATH dient ausschließlich als Quelle für die explizite SQLite-Migration.
SECURE_COOKIES=false
# Bei HTTPS-Veröffentlichung: öffentliche URL ohne Pfad, SECURE_COOKIES=true.
PUBLIC_ORIGIN=
# Nur IP-Adressen eigener Reverse-Proxys; leer ignoriert X-Forwarded-For.
# Lokaler Nginx mit Loopback-Backend: 127.0.0.1,::1
TRUSTED_PROXIES=
# Mit HTTPS-Konfiguration auf production setzen.
NODE_ENV=development
